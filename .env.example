# ---------------------------------------------------------------------------
# منصة المدربة أم هشام — متغيرات البيئة
# انسخ هذا الملف إلى ‎.env.local‎ ثم املأ القيم الحقيقية.
#   cp .env.example .env.local
# لا ترفع ملف ‎.env.local‎ إلى GitHub إطلاقًا.
# ---------------------------------------------------------------------------

# ── Supabase ───────────────────────────────────────────────────────────────
# من لوحة Supabase: Project Settings ▸ Data API  و  Project Settings ▸ API Keys

# رابط المشروع، مثال: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# المفتاح العام (anon / publishable). آمن للاستخدام في المتصفح لأن RLS يحميه.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة (service_role / secret). سري تمامًا — خادمي فقط.
# يستخدم في: تصحيح الاختبارات، جلب الأسئلة دون كشف الإجابات، رفع الملفات.
# لا تضعه أبدًا في أي متغير يبدأ بـ NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# اسم مجلد التخزين الخاص بملفات المحاضرات (يُنشأ في schema.sql)
SUPABASE_STORAGE_BUCKET=course-files

# ── Claude API (Anthropic) ─────────────────────────────────────────────────
# من https://console.anthropic.com ▸ API Keys
# يستخدم فقط داخل مسار الخادم /api/ai/generate-quiz — لا يصل إلى المتصفح.
ANTHROPIC_API_KEY=

# اسم النموذج (اتركه كما هو ما لم تكن تعرف ما تفعل)
ANTHROPIC_MODEL=claude-opus-5

# ── إعدادات عامة ───────────────────────────────────────────────────────────
# العنوان الأساسي للموقع، يستخدم في روابط تفعيل البريد
# محليًا: http://localhost:3000 — بعد النشر: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# البريد الذي سيُمنح صلاحية المدربة (admin) تلقائيًا عند التسجيل
ADMIN_EMAIL=
